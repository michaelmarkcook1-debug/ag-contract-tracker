# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# SQLite dev database (regenerated via migrations + seeds)
dev.db
dev.db-shm
dev.db-wal
prisma/dev.db
prisma/dev.db-shm
prisma/dev.db-wal

# Large data assets — kept locally, not committed
historical data_globaldata/
old code/

# SQLite backup before Neon migration
dev.db.sqlite-backup*

# Editor & local config
.claude/
.idea/
.vscode/
