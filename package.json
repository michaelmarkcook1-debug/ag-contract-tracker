{
  "name": "ag-contract-tracker",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:seed": "npx tsx prisma/seed.ts",
    "db:import:globaldata": "python3 scripts/import-globaldata.py",
    "db:import:predecessor": "npx tsx scripts/import-predecessor.ts",
    "db:studio": "npx prisma studio",
    "db:reset": "npx prisma migrate reset --force && npm run db:seed",
    "dedup": "npx tsx scripts/dedup-semantic.ts",
    "dedup:titles": "npx tsx scripts/dedup-titles.ts",
    "ingest": "curl -s http://localhost:3000/api/ingestion -X POST -H 'content-type: application/json' -d '{\"sourceFilter\":\"all\",\"maxSources\":15}' | python3 -m json.tool",
    "ingest:dry": "curl -s http://localhost:3000/api/ingestion -X POST -H 'content-type: application/json' -d '{\"sourceFilter\":\"vendor_rss\",\"maxSources\":6,\"dryRun\":true}' | python3 -m json.tool",
    "cron:setup": "bash scripts/setup-cron.sh http://localhost:3000"
  },
  "dependencies": {
    "@base-ui/react": "^1.5.0",
    "@neondatabase/serverless": "^1.1.0",
    "@prisma/adapter-better-sqlite3": "^7.8.0",
    "@prisma/adapter-neon": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "better-sqlite3": "^12.10.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "prisma": "^7.8.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "recharts": "^3.8.1",
    "shadcn": "^4.10.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "typescript": "^5"
  }
}
