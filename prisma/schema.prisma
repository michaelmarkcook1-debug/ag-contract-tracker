generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Entity Registry ─────────────────────────────────────────────────────────

model Entity {
  id            String   @id @default(cuid())
  canonicalName String   @unique
  displayName   String
  slug          String   @unique
  entityType    String   // vendor | client | both
  parentId      String?
  parent        Entity?  @relation("EntityHierarchy", fields: [parentId], references: [id])
  children      Entity[] @relation("EntityHierarchy")
  regions       String   @default("[]") // JSON
  logoUrl       String?
  websiteUrl    String?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  aliases           EntityAlias[]
  primaryEvents     CanonicalMarketEvent[] @relation("PrimaryEntity")
  contractsAsVendor ContractDetails[]      @relation("ContractVendor")
  contractsAsClient ContractDetails[]      @relation("ContractClient")
  maAcquirer        MaDetails[]            @relation("MaAcquirer")
  maTarget          MaDetails[]            @relation("MaTarget")
  partnershipA      PartnershipDetails[]   @relation("PartnershipEntityA")
  partnershipB      PartnershipDetails[]   @relation("PartnershipEntityB")
  orgChangeEntity   OrgChangeDetails[]     @relation("OrgChangeEntity")
}

model EntityAlias {
  id       String @id @default(cuid())
  entityId String
  alias    String
  entity   Entity @relation(fields: [entityId], references: [id])

  @@unique([entityId, alias])
  @@index([alias])
}

// ─── Source Events (raw articles) ────────────────────────────────────────────

model SourceEvent {
  id                   String   @id @default(cuid())
  sourceUrl            String   @unique
  rawTextHash          String?
  sourceTitle          String?
  sourceName           String?
  sourceType           String
  publicationDate      DateTime?
  retrievedAt          DateTime @default(now())
  rawText              String?
  extractedFamily      String   @default("UNKNOWN")
  extractionConfidence Float    @default(0)
  processingStatus     String   @default("pending")
  processingError      String?
  // Model read attempts that FAILED (truncation, timeout, unparseable output).
  // Deferral for lack of time is not an attempt. After MAX_READ_ATTEMPTS the
  // row becomes "failed" — visible, never silently retried for ever (a list of
  // 36 acquisitions that truncated every day blocked the queue for 15 days).
  readAttempts         Int      @default(0)
  // Why an article was excluded ("rules:hard_exclude", "rules:vendor_gate",
  // "model:no_tracked_vendor", "model:excluded_noise", …). Written with
  // processingStatus "excluded" so the URL is never re-triaged — before this,
  // model rejections left no row and were re-bought on every run.
  exclusionReason      String?
  // Publisher URL behind an aggregator redirect (Google News), once resolved.
  publisherUrl         String?
  // ── Reading provenance (AI Delivery Mandate §23) ──
  // What the model read and with which policy, so a result is reproducible.
  articleType          String?
  articleTextHash      String?   // sha256 of the text actually analysed (not the URL)
  articleTextChars     Int?
  modelId              String?
  promptPolicyVersion  String?
  analysedAt           DateTime?
  // A row re-admitted after an exclusion keeps the old verdict (§20): regression evidence.
  previousExclusionReason String?
  // ── Tier 2 article recovery state (§4, §5) ──
  // Redirect resolution and body fetch are rate-limited; persisted state stops
  // a permanently-dead URL being re-attempted on every future run.
  redirectState        String?   // RESOLVED | ALREADY_RESOLVED | FAILED | BLOCKED | INVALID | NOT_APPLICABLE
  redirectAttemptedAt  DateTime?
  bodyState            String?   // FULL_TEXT | PARTIAL_ARTICLE | SNIPPET_ONLY | UNREADABLE | FETCH_FAILED
  bodyAttemptedAt      DateTime?
  bodyAttempts         Int       @default(0)
  bodyChars            Int?
  ingestionRunId       String?
  ingestionRun         IngestionRun? @relation(fields: [ingestionRunId], references: [id])

  canonicalEvents CanonicalMarketEvent[]
  createdAt       DateTime @default(now())

  @@index([processingStatus])
  @@index([publicationDate])
  @@index([publisherUrl])
  @@index([redirectState])
  @@index([bodyState])
}

// ─── Canonical Market Events ──────────────────────────────────────────────────

model CanonicalMarketEvent {
  id                       String   @id @default(cuid())
  family                   String
  eventType                String
  canonicalTitle           String
  announcementDate         DateTime?
  announcementDateBasis    String   @default("unavailable")
  effectiveDate            DateTime?
  geography                String   @default("[]")
  industry                 String?
  industryBasis            String   @default("unavailable")
  confidenceScore          Float    @default(0)
  // How confidenceScore came to exist: "measured" (computed from observable
  // signals, capped at 0.89 by the classifier) or "asserted" (hard-coded by a
  // writer that measures nothing). An asserted value must never satisfy a
  // measured-confidence gate — see gate.ts.
  confidenceBasis          String?
  commercialRelevanceScore Float    @default(0)
  humanReviewRequired      Boolean  @default(true)
  publicationStatus        String   @default("published")
  analystInsight           String?
  analystInsightConfidence Float?
  originalArticleUrl       String?
  // Machine-readable reason the event sits in needs_review, e.g.
  // "low_confidence:0.55" or "event_type_invalid:technology_alliance".
  reviewReason             String?
  // Counterparty as extracted (client / target / partner), every family.
  // Basis for cross-run dedup; the family detail tables are not always filled.
  counterpartyRaw          String?
  // ── AI Delivery Mandate commercial-event fields (§7, §8, §10, §11, §16) ──
  // Deterministic identity independent of article URL: sha256 of provider |
  // normalised buyer | commercial event type | first-observed month.
  canonicalContractEventId String?  @unique
  // NEW_WIN | RENEWAL | EXTENSION | EXPANSION | SCOPE_REDUCTION | RECOMPETE |
  // COMPETITIVE_TAKEAWAY | REPLACEMENT | TERMINATION | CONTRACT_CHANGE |
  // OTHER_COMMERCIAL_EVENT | UNKNOWN
  commercialEventType      String?
  // ANNOUNCED | COMPLETED | OPPORTUNITY | TERMINATED | DISPUTED | UNKNOWN
  eventStatus              String?
  // PRIVATE_SECTOR | PUBLIC_SECTOR | STATE_OWNED_OR_MIXED | NON_PROFIT | UNKNOWN
  buyerSector              String?
  // EXPLICIT_AI | AI_MATERIAL | AI_ADJACENT | NOT_AI_SPECIFIC | UNKNOWN
  aiRelevance              String?
  // JSON: claim → the article passage that supports it (grounding, §9)
  supportingText           String?
  // Prompt policy that produced this event
  readerVersion            String?

  primaryEntityId String?
  primaryEntity   Entity? @relation("PrimaryEntity", fields: [primaryEntityId], references: [id])

  sourceEvents       SourceEvent[]
  contractDetails    ContractDetails?
  maDetails          MaDetails?
  partnershipDetails PartnershipDetails?
  orgChangeDetails   OrgChangeDetails?
  offeringDetails    OfferingDetails?
  dedupLinks         DedupDecision[] @relation("DedupEventA")
  dedupLinkedBy      DedupDecision[] @relation("DedupEventB")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([family])
  @@index([publicationStatus])
  @@index([announcementDate])
  @@index([primaryEntityId])
  @@index([buyerSector])
  @@index([commercialEventType])
  @@index([confidenceBasis])
}

// ─── Family Detail Tables ─────────────────────────────────────────────────────

model ContractDetails {
  id               String               @id @default(cuid())
  canonicalEventId String               @unique
  canonicalEvent   CanonicalMarketEvent @relation(fields: [canonicalEventId], references: [id])

  vendorId         String?
  vendor           Entity? @relation("ContractVendor", fields: [vendorId], references: [id])
  vendorRaw        String?
  vendorConfidence Float   @default(0)

  clientId         String?
  client           Entity? @relation("ContractClient", fields: [clientId], references: [id])
  clientRaw        String?
  clientAnonymised Boolean @default(false)
  clientDescriptor String?
  clientIndustry   String?
  clientConfidence Float   @default(0)

  contractEventType  String?
  previousVendorRaw  String?
  incumbentDisplaced Boolean?

  contractStartDate          DateTime?
  contractStartDatePrecision String    @default("unknown")
  contractEndDate            DateTime?
  contractEndDatePrecision   String    @default("unknown")
  contractLengthMonths       Int?
  contractLengthDescriptor   String?
  // ── Commercial mechanics (AI Delivery Mandate §12) — only when the text supports them ──
  pricingModel        String?   // fixed price | time and materials | capped | outcome-based | consumption | day rate | mixed
  outcomePricing      Boolean?
  feeAtRisk           Boolean?
  consumptionModel    Boolean?
  renewalPeriodMonths Int?
  expansionValueUsd   Float?
  acvUsd              Float?

  tcvCommittedUsd     Float?
  tcvCeilingUsd       Float?
  tcvFrameworkUsd     Float?
  tcvEstimateLowUsd   Float?
  tcvEstimateMidUsd   Float?
  tcvEstimateHighUsd  Float?
  tcvOriginalCurrency String?
  tcvOriginalValue    Float?
  tcvBasis            String  @default("undisclosed")
  tcvIsEstimate       Boolean @default(false)
  tcvConfidence       String  @default("do_not_estimate")
  // Value engine (2026-09-08): how a labelled estimate was produced and from what
  tcvEstimateMethod      String?   // bpo_rate_card | value_model | comparables
  tcvEstimateInputs      String?   // JSON: the stated inputs the estimate used
  tcvEstimateExplanation String?   // one line a reader can check
  tcvEstimateVersion     String?   // model / rate-card version
  // Stated sizing facts the reader grounds in the article
  agentCount        Int?      // agents / FTEs / seats the provider deploys
  agentTarget       Int?      // planned scale-up, when only a target is stated
  deliveryLocations String?   // JSON array of countries/cities the provider delivers from
  workType          String?   // VOICE | NON_VOICE | SPECIALISED | UNKNOWN
  usersServed       Int?      // client population the work supports

  primaryMacroServiceLine    String?
  primaryMicroServiceLine    String?
  secondaryMacroServiceLines String  @default("[]")
  secondaryMicroServiceLines String  @default("[]")
  scopeSummary               String?
  platformsUsed              String  @default("[]")

  signingLocation               String?
  clientServiceCoverageLocation String @default("[]")
  vendorDeliveryCentreLocation  String @default("[]")
}

model MaDetails {
  id               String               @id @default(cuid())
  canonicalEventId String               @unique
  canonicalEvent   CanonicalMarketEvent @relation(fields: [canonicalEventId], references: [id])

  maEventType          String?
  acquirerId           String?
  acquirer             Entity? @relation("MaAcquirer", fields: [acquirerId], references: [id])
  acquirerRaw          String?
  targetId             String?
  target               Entity? @relation("MaTarget", fields: [targetId], references: [id])
  targetRaw            String?
  dealValueUsd         Float?
  dealValueBasis       String  @default("undisclosed")
  stakePercent         Float?
  statusAtAnnouncement String  @default("announced")
  rationale            String?
}

model PartnershipDetails {
  id               String               @id @default(cuid())
  canonicalEventId String               @unique
  canonicalEvent   CanonicalMarketEvent @relation(fields: [canonicalEventId], references: [id])

  partnershipType String?
  entityAId       String?
  entityA         Entity? @relation("PartnershipEntityA", fields: [entityAId], references: [id])
  entityARaw      String?
  entityBId       String?
  entityB         Entity? @relation("PartnershipEntityB", fields: [entityBId], references: [id])
  entityBRaw      String?
  scopeSummary    String?
  platformFocus   String?
}

model OrgChangeDetails {
  id               String               @id @default(cuid())
  canonicalEventId String               @unique
  canonicalEvent   CanonicalMarketEvent @relation(fields: [canonicalEventId], references: [id])

  orgEventType    String?
  entityId        String?
  entity          Entity? @relation("OrgChangeEntity", fields: [entityId], references: [id])
  personName      String?
  roleName        String?
  previousRole    String?
  locationCity    String?
  locationCountry String?
  headcount       Int?
  rationale       String?
}

model OfferingDetails {
  id               String               @id @default(cuid())
  canonicalEventId String               @unique
  canonicalEvent   CanonicalMarketEvent @relation(fields: [canonicalEventId], references: [id])

  offeringType  String?
  vendorRaw     String?
  offeringName  String?
  scopeSummary  String?
  targetMarket  String?
  platformsUsed String @default("[]")
}

// ─── Dedup Decisions ──────────────────────────────────────────────────────────

model DedupDecision {
  id               String               @id @default(cuid())
  eventAId         String
  eventA           CanonicalMarketEvent @relation("DedupEventA", fields: [eventAId], references: [id])
  eventBId         String
  eventB           CanonicalMarketEvent @relation("DedupEventB", fields: [eventBId], references: [id])
  decision         String
  confidence       Float    @default(0)
  mergeRecommended Boolean  @default(false)
  linkRecommended  Boolean  @default(false)
  reasonCodes      String   @default("[]")
  riskFlags        String   @default("[]")
  humanReviewRequired Boolean @default(true)
  resolvedAt       DateTime?
  resolvedBy       String?
  createdAt        DateTime @default(now())

  @@unique([eventAId, eventBId])
}

// ─── Source Registry ──────────────────────────────────────────────────────────

model SourceRegistryItem {
  id                String   @id @default(cuid())
  name              String
  provider          String
  url               String   @unique
  sourceType        String
  tier              String   @default("tier_2_secondary")
  fetchMethod       String   @default("rss")
  isActive          Boolean  @default(true)
  lastCrawledAt     DateTime?
  nextDueAt         DateTime?
  lastItemCount     Int      @default(0)
  consecutiveErrors Int      @default(0)
  lastError         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([isActive])
  @@index([nextDueAt])
}

model ReviewAction {
  id             String   @id @default(cuid())
  eventId        String
  action         String   // approved | rejected | title_edited | family_changed
  reviewerNote   String?
  previousValue  String?
  newValue       String?
  createdAt      DateTime @default(now())

  @@index([eventId])
}

// ─── Ingestion Infrastructure ─────────────────────────────────────────────────

model IngestionRun {
  id              String   @id @default(cuid())
  runType         String
  sourceFilter    String?
  startedAt       DateTime @default(now())
  completedAt     DateTime?
  status          String   @default("running")
  articlesFound   Int      @default(0)
  articlesDuped   Int      @default(0)
  eventsExtracted Int      @default(0)
  eventsPublished Int      @default(0)
  eventsQueued    Int      @default(0)
  // Funnel stages between "found" and "extracted", so a run is auditable.
  articlesRelevant Int     @default(0) // survived rules, vendor gate, age cutoff
  articlesStale    Int     @default(0) // skipped: older than maxArticleAgeDays
  articlesTriaged  Int     @default(0) // sent to the triage model
  articlesExcluded Int     @default(0) // triage/analysis judged out of scope
  articlesDeferred Int     @default(0) // relevant, not reached within the budget
  articlesMerged   Int     @default(0) // attached to an existing event (dedup)
  errors          String   @default("[]")
  // Real LLM spend for the run, summed from Messages API usage fields.
  inputTokens     Int      @default(0)
  outputTokens    Int      @default(0)
  costUsd         Float    @default(0)

  sourceEvents SourceEvent[]
  // §14: a run whose execution dies must not stay RUNNING for ever.
  heartbeatAt     DateTime?
  endedReason     String?

  @@index([status, heartbeatAt])
}

// ─── Operating mode ───────────────────────────────────────────────────────────
// Tiny key/value table so a local runner and the deployed cron agree on the
// ingestion phase: "historical" (backfill in progress; the cron pauses) or
// "current" (the cron gathers new articles). Written by scripts/backfill-history.ts.
model SystemSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
